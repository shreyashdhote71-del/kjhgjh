# Copy this file to .env, fill it in, and restart the server.

# Required. Encrypts emails, profiles, photos, ID documents and backups. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep a copy somewhere safe, away from this folder: without this key the data cannot be read by anyone.
DATA_KEY=put64hexcharactershere

# Required. The PostgreSQL database, see README.txt. If the password has symbols, write them URL-encoded.
DATABASE_URL=postgres://onera:yourpassword@localhost:5432/onera

# Backups: these are the defaults, change them only if you need to
# BACKUP_DIR=C:\onera-backups
# Best on another disk, or a folder that syncs to the cloud:
# BACKUP_COPY_DIR=D:\onera-backups
# Hour of the daily backup, 0-23:
# BACKUP_HOUR=2
# BACKUP_KEEP_DAYS=14
# Gets an email when a backup fails (needs SMTP below):
# BACKUP_ALERT_EMAIL=you@example.com
# Folder holding pg_dump, if it is not found by itself:
# PG_BIN=C:\Program Files\PostgreSQL\18\bin

# Large sites, see README.txt
# Server processes, one per CPU core is best (default: up to 4)
# WORKERS=4
# Database connections per process. WORKERS x PG_POOL must stay below PostgreSQL's max_connections
# PG_POOL=10
# Where uploaded files are kept. On a hosting service, this must be a persistent disk
# DATA_DIR=/var/data/onera

# HTTPS: use ONE of these two, see README.txt
# 1) A host that gives HTTPS itself (Render, Railway and similar):
# TRUST_PROXY=1
# 2) Your own server with a certificate:
# TLS_KEY_FILE=/etc/letsencrypt/live/yourdomain/privkey.pem
# TLS_CERT_FILE=/etc/letsencrypt/live/yourdomain/fullchain.pem
# PORT=443
# HTTP_PORT=80

# Gmail needs an App Password, not your normal password:
# Google Account > Security > 2-Step Verification > App passwords
SMTP_USER=youraddress@gmail.com
SMTP_PASS=your16characterapppassword

# Other mail providers only: uncomment and change
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
